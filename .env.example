# Copy to .env and fill in. Nothing here has a working default on purpose —
# a development secret that reaches production is worse than a boot failure.

ENVIRONMENT=local
DEBUG=true

# --- Database ---
POSTGRES_USER=wpx
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=wealthpilotx
POSTGRES_PORT=5432

# --- Secrets (min 32 chars each) ---
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Rotating this makes every stored income/savings value undecryptable.
# Re-encrypting existing rows is a migration, not an env change.
PROFILE_ENCRYPTION_KEY=

# --- Ports ---
API_PORT=8000
WEB_PORT=5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Data providers (M2, PRD §7.3) ---
# "synthetic" needs no network and no API key — the default so a fresh clone works.
# Switch to "yahoo" / "fred" for real data.
MARKET_DATA_PROVIDER=synthetic
ECONOMIC_DATA_PROVIDER=synthetic

# Required only when ECONOMIC_DATA_PROVIDER=fred.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# How far back `python -m app.jobs ingest-market --backfill-days` reaches by default.
INGESTION_BACKFILL_DAYS=730
# Hours without a successful ingestion before /health reports it stale (FR-04).
# 48, not 24, so a normal weekend does not alert every Sunday.
MARKET_DATA_STALE_AFTER_HOURS=48
